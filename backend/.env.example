APP_NAME="Food Reservation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Taipei
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_TW

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=food_db
DB_USERNAME=food
DB_PASSWORD=foodsecret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=food_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=redissecret
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@food.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,127.0.0.1

ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
ECPAY_ENV=test
# 綠界打不到 localhost，本機開發用「付款模擬器」代替背景通知（僅非正式環境有效）。
# 要接真正的綠界測試環境：執行 ./scripts/ecpay-tunnel.sh up，會自動設定 ECPAY_NOTIFY_URL，見 docs/payment.md
ECPAY_SIMULATOR=false
FRONTEND_URL=http://localhost

SMS_DRIVER=mock
SMS_API_KEY=
SMS_API_SECRET=

# 菜單圖片的儲存磁碟與對外網址前綴，說明見 docs/menu.md（換成 S3／MinIO 只要改磁碟設定）
MENU_IMAGE_DISK=uploads
UPLOADS_URL=/uploads

# 訂位：防超賣策略 atomic | pessimistic（unsafe 只給壓測示範，正式環境會被拒絕），說明見 docs/booking.md
BOOKING_STRATEGY=atomic
BOOKING_ALLOW_STRATEGY_HEADER=false
BOOKING_CREATE_RATE_LIMIT=10
BOOKING_PUBLIC_READ_RATE_LIMIT=120

MOCK_ERP_URL=http://mock-erp:3000
MOCK_ERP_TIMEOUT=5

VITE_APP_NAME="${APP_NAME}"

