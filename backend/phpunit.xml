<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <!--
            Docker 已把 backend/.env 的值注入成環境變數（DB_DATABASE=food_db、CACHE_STORE=redis…），
            而 Laravel 讀 env 時 $_SERVER 優先，所以下列設定必須同時用 force 覆蓋 $_ENV 與 $_SERVER，
            否則測試會動到開發用的資料庫與 Redis（RefreshDatabase 會直接清空資料）。
        -->
        <env name="DB_DATABASE" value="food_testing" force="true"/>
        <server name="DB_DATABASE" value="food_testing" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <!-- 金流日誌是獨立檔案、不受 LOG_CHANNEL 影響；測試不該把假的通知寫進開發環境的金流日誌 -->
        <env name="PAYMENT_LOG_LEVEL" value="emergency" force="true"/>
        <server name="PAYMENT_LOG_LEVEL" value="emergency" force="true"/>
        <!-- 既有的訂位／付款測試不關心手機驗證，所以預設用寬鬆模式（直接採用請求裡的手機號碼）；
             驗證流程本身的測試（Sms/）自己用 config() 打開嚴格模式。正式環境一律嚴格，見 PhoneAuth -->
        <env name="SMS_REQUIRE_VERIFICATION" value="false" force="true"/>
        <server name="SMS_REQUIRE_VERIFICATION" value="false" force="true"/>
        <env name="SMS_DRIVER" value="mock" force="true"/>
        <server name="SMS_DRIVER" value="mock" force="true"/>
        <env name="SMS_LOG_LEVEL" value="emergency" force="true"/>
        <server name="SMS_LOG_LEVEL" value="emergency" force="true"/>
        <!-- 本機付款模擬器預設關閉；需要的測試自己用 config() 開啟 -->
        <env name="ECPAY_SIMULATOR" value="false" force="true"/>
        <server name="ECPAY_SIMULATOR" value="false" force="true"/>
    </php>
</phpunit>
